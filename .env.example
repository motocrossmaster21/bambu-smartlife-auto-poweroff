# Copy to .env locally. Never commit .env or runtime/.
TZ=Europe/Zurich
# Replace with the NAS LAN IPv4 address. Loopback is a safe setup default.
HA_BIND_IP=127.0.0.1
HA_CONFIG_DIR=./runtime/homeassistant
# Alternatively: /share/Container/bambu-homeassistant/config
# Actual IDs: Home Assistant -> Developer tools -> States.
P1S_STATUS_ENTITY=sensor.replace_with_p1s_print_status
P1S_NOZZLE_ENTITY=sensor.replace_with_p1s_nozzle_temperature
P1S_NOZZLE_TARGET_ENTITY=sensor.replace_with_p1s_nozzle_target
P1S_BED_ENTITY=sensor.replace_with_p1s_bed_temperature
P1S_BED_TARGET_ENTITY=sensor.replace_with_p1s_bed_target
P1S_PROGRESS_ENTITY=sensor.replace_with_p1s_print_progress
P1S_ONLINE_ENTITY=binary_sensor.replace_with_p1s_online
P1S_PLUG_ENTITY=switch.replace_with_p1s_power_plug
TUYA_BRIDGE_ENTRY_ID=replace_with_bridge_config_entry_id
SAFE_NOZZLE_TEMPERATURE=50
STABLE_SECONDS=30
MAX_DATA_AGE_SECONDS=60
POWER_OFF_TIMEOUT_SECONDS=20
# Bambu login, Tuya QR login and bridge API key use official HA config flows.
# They do NOT support generic BAMBU_PASSWORD/TUYA_SECRET environment variables.
# Their local tokens/credentials are persisted only in the ignored /config volume.
