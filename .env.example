# Local demo first: no cloud connection, no Smart Life events, no plug commands.
MODE=demo
BIND_IP=127.0.0.1
PORT=8089
# Set MODE=live only after Tuya product/device setup; see docs/smartlife.md.
BAMBU_REGION=global
BAMBU_SERIAL=
BAMBU_USERNAME=
BAMBU_ACCESS_TOKEN=
TUYA_DEVICE_ID=
TUYA_DEVICE_SECRET=
# Use the MQTT endpoint of the TuyaLink device's data center.
TUYA_MQTT_HOST=m1.tuyaeu.com
TUYA_PROPERTY_CODE=bambu_off
SAFE_NOZZLE_TEMPERATURE=50
STABLE_SECONDS=30
PULSE_SECONDS=30
# Maximum nozzle measurement age and gap between relevant printer reports.
MAX_DATA_AGE_SECONDS=60
